alias la='list_aliases'
alias ls='ls -G'
alias ua='vim "$DOTFILES_FOLDER"/files/.aliases'
alias upa='vim "~/.aliases.private'
alias ue='vim "$DOTFILES_FOLDER"/files/.env'
alias upe='vim "~/.env.private'
alias s='source ~/.zshrc'
alias c='clear'
alias x='exit'
alias od='code $DOTFILES_FOLDER'
alias cdd='cd $DOTFILES_FOLDER'
alias udf='update_dotfiles'
alias cdf='clear_dotfiles'
